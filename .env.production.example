# Template only. Copy privately on the server and replace every REPLACE_ME value.
# Never overwrite an existing production APP_KEY or production .env.
APP_NAME="Chain Earn"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE_ME
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_ME
DB_USERNAME=REPLACE_ME
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CHAIN_SIMULATION_ENABLED=false

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=REPLACE_ME
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_ME
MAIL_FROM_NAME="${APP_NAME}"

BUSINESS_LEGAL_NAME="chain earn pvt.ltd"
BUSINESS_ADDRESS="Bhosalewasti, Indapur, Nimgaon Ketki, Pune, Maharashtra - 413120"
BUSINESS_SUPPORT_EMAIL=info@chainearn.in
BUSINESS_SUPPORT_PHONE=8308002855
BUSINESS_PRIVACY_CONTACT=REPLACE_ME
BUSINESS_PRIVACY_EMAIL=info@chainearn.in
VITE_APP_NAME="${APP_NAME}"
